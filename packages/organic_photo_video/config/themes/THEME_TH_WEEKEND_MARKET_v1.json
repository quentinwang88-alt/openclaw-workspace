      {"slot_index": 4, "slot_role": "detail", "purpose": "棉麻质感与编织配饰细节", "duration_ms": 2200, "motion": "detail_zoom", "transition_out": "short_dissolve"},
      {"slot_index": 5, "slot_role": "second_angle", "purpose": "傍晚暖光第二机位收尾", "duration_ms": 3000, "motion": "slow_push", "transition_out": "cut"}

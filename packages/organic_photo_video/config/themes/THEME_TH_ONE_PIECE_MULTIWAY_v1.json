{
  "schema_version": "opv-theme-v1",
  "theme_id": "THEME_TH_ONE_PIECE_MULTIWAY_V1",
  "theme_key": "THEME_TH_ONE_PIECE_MULTIWAY",
  "theme_version": 1,
  "theme_name": "一衣多穿（One Piece Multiway）",
  "description": "同一件主商品固定上下装与鞋包，只换外套/配饰/穿法展示多种造型，突出商品性价比。",
  "status": "active",
  "applicable_markets": ["TH"],
  "product_match_rules": {
    "categories": ["dress", "shirt", "top_bottom_sets", "versatile_blazer"],
    "size_hint": "以商品实际版型为准",
    "climate": "同 Market Pack 气候约束",
    "avoid": ["主题中途更换下装或鞋包（违反一衣多穿设定）"]
  },
  "content_plan_rules": {
    "look_source_priority": ["successful_look", "look_template", "ai_exploration"],
    "copy_tone": "一件 N 穿的性价比叙事，强调เดรสตัวเดียว",
    "bgm_mood_hints": ["mid_tempo_pop", "transformation_beat"],
    "overlay_text_hint": "ตัวเดียวใส่ได้ 3 แบบ",
    "overlay_instruction": "ข้อความสั้นหนึ่งบรรทัดสำหรับปก",
    "hashtag_seed": ["#หนึ่งตัวหลายลุค", "#ป้ายยา", "#คุ้มมาก"],
    "cross_image_rule": "P1-P5 主商品、下装、鞋包必须完全一致，仅外套与配饰变化"
  },
  "default_storyboard": {
    "topic_template": "เดรสตัวเดียว 3 ลุค: {product} คุ้มทุกการเดท",
    "slots": [
      {"slot_index": 1, "slot_role": "hero", "purpose": "主穿法完整 Look 钩子", "duration_ms": 2200, "motion": "slow_push", "transition_out": "short_dissolve"},
      {"slot_index": 2, "slot_role": "full_look", "purpose": "第二种穿法（换外套）", "duration_ms": 2600, "motion": "light_pan", "transition_out": "short_dissolve"},
      {"slot_index": 3, "slot_role": "lifestyle", "purpose": "第三种穿法生活场景", "duration_ms": 2500, "motion": "static_hold", "transition_out": "short_dissolve"},
      {"slot_index": 4, "slot_role": "detail", "purpose": "主商品细节强调（同款不同穿）", "duration_ms": 2200, "motion": "detail_zoom", "transition_out": "short_dissolve"},
      {"slot_index": 5, "slot_role": "second_angle", "purpose": "三种穿法同框总结收尾", "duration_ms": 3000, "motion": "light_pan", "transition_out": "cut"}
    ]
  }
}

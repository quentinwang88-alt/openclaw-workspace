{
  "schema_version": "opv-theme-v1",
  "theme_id": "THEME_TH_COLOR_POP_V1",
  "theme_key": "THEME_TH_COLOR_POP",
  "theme_version": 1,
  "theme_name": "泰式亮色撞色实验（Color Pop）",
  "description": "用高饱和泰式亮色做撞色实验，测试账号视觉记忆点和首屏停留。",
  "status": "active",
  "applicable_markets": ["TH"],
  "product_match_rules": {
    "categories": ["bright_dress", "colorful_top", "statement_skirt", "accessory_sets"],
    "size_hint": "不限，突出色彩",
    "climate": "高饱和色在自然光下表现好的面料",
    "avoid": ["灰暗色调商品"]
  },
  "content_plan_rules": {
    "look_source_priority": ["successful_look", "look_template", "ai_exploration"],
    "copy_tone": "视觉冲击型短文案，情绪外放",
    "bgm_mood_hints": ["high_energy", "dance", "trendy_remix"],
    "overlay_text_hint": "สีนี้ใส่แล้วผิวดูสว่าง",

    "hashtag_seed": ["#สีสัน", "#แมทช์สี", "#แต่งสีสด"],
    "experiment_note": "exploration theme：每组记录色彩组合反馈，为 Successful Look 积累证据"
  },
  "default_storyboard": {
    "topic_template": "ลองแมทช์สี: {product} สีสดแต่ไม่หวือเกิน",
    "slots": [
      {"slot_index": 1, "slot_role": "hero", "purpose": "撞色 Look 强视觉钩子", "duration_ms": 2200, "motion": "slow_push", "transition_out": "short_dissolve"},
      {"slot_index": 2, "slot_role": "full_look", "purpose": "整组配色关系全身展示", "duration_ms": 2600, "motion": "light_pan", "transition_out": "short_dissolve"},
      {"slot_index": 3, "slot_role": "lifestyle", "purpose": "彩色墙/街头自然状态", "duration_ms": 2500, "motion": "static_hold", "transition_out": "short_dissolve"},
      {"slot_index": 4, "slot_role": "detail", "purpose": "配色呼应的配饰细节", "duration_ms": 2200, "motion": "detail_zoom", "transition_out": "short_dissolve"},
      {"slot_index": 5, "slot_role": "second_angle", "purpose": "第二机位同配色收尾", "duration_ms": 3000, "motion": "light_pan", "transition_out": "cut"}
    ]
  }

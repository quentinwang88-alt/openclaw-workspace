{
  "schema_version": "opv-theme-v1",
  "theme_id": "THEME_TH_PETITE_PROPORTION_V1",
  "theme_key": "THEME_TH_PETITE_PROPORTION",
  "theme_version": 1,
  "theme_name": "小个子显高比例（Petite Proportion）",
  "description": "用高腰线、短上衣和纵向线条优化小个子比例，泰国日常通勤和逛街都适用。",
  "status": "active",
  "applicable_markets": ["TH"],
  "product_match_rules": {
    "categories": ["blouse", "crop_top", "high_waist_skirt", "wide_leg_pants", "dress"],
    "size_hint": "S-M 区间，长度偏短或可调节",
    "climate": "breathable fabrics only",
    "avoid": ["oversized_longline_coat", "heavy_layering"]
  },
  "content_plan_rules": {
    "look_source_priority": ["successful_look", "look_template", "ai_exploration"],
    "copy_tone": "比例技巧干货感 + 轻松口吻，泰语口语",
    "bgm_mood_hints": ["bright", "playful", "upbeat_pop"],
    "overlay_text_hint": "ใส่แล้วดูสูงขึ้นทันที",
    "overlay_instruction": "ข้อความสั้นหนึ่งบรรทัดต่อหนึ่งภาพ",
    "hashtag_seed": ["#ป้ายยา", "#ตัวเล็ก", "#แมทช์ได้ทุกวัน"]
  },
  "default_storyboard": {
    "topic_template": "สาวตัวเล็กต้องรู้: {product} จัดวางยังไงให้ขาดูยาว",
    "slots": [
      {"slot_index": 1, "slot_role": "hero", "purpose": "完整 Look + 显高对比钩子", "duration_ms": 2200, "motion": "slow_push", "transition_out": "short_dissolve"},
      {"slot_index": 2, "slot_role": "full_look", "purpose": "上下装关系与腰线位置", "duration_ms": 2600, "motion": "light_pan", "transition_out": "short_dissolve"},
      {"slot_index": 3, "slot_role": "lifestyle", "purpose": "行走/逛街自然状态显腿长", "duration_ms": 2500, "motion": "slow_push", "transition_out": "short_dissolve"},
      {"slot_index": 4, "slot_role": "detail", "purpose": "腰线/鞋包比例细节", "duration_ms": 2200, "motion": "detail_zoom", "transition_out": "short_dissolve"},
      {"slot_index": 5, "slot_role": "second_angle", "purpose": "第二机位全身收尾", "duration_ms": 3000, "motion": "light_pan", "transition_out": "cut"}
    ]
  }
}

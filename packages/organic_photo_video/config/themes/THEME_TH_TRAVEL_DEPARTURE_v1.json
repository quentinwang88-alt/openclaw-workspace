{
  "schema_version": "opv-theme-v1",
  "theme_id": "THEME_TH_TRAVEL_DEPARTURE_V1",
  "theme_key": "THEME_TH_TRAVEL_DEPARTURE",
  "theme_version": 1,
  "theme_name": "机场旅行出发（Travel Departure）",
  "description": "出发去凉爽目的地的机场旅行穿搭：值机大厅、玻璃幕墙、行李箱语境。厚外套类商品在热湿市场仅允许旅行/空调语境使用，本主题是该约束下的标准载体。",
  "status": "active",
  "applicable_markets": [
    "TH"
  ],
  "product_match_rules": {
    "categories": [
      "outerwear",
      "puffer_jacket",
      "light_jacket",
      "coat",
      "blazer"
    ],
    "size_hint": "以商品实际版型为准",
    "climate": "热湿市场限旅行出发或空调室内语境；机场外景控制在清晨/傍晚光线",
    "avoid": [
      "把厚外套放进日常街头无语境场景",
      "夏天泳池/海滩语境"
    ]
  },
  "content_plan_rules": {
    "look_source_priority": [
      "successful_look",
      "look_template",
      "ai_exploration"
    ],
    "copy_tone": "出发前兴奋感的旅行分享口吻，泰语口语，强调穿去机场舒服又出片",
    "bgm_mood_hints": [
      "dance",
      "high_energy",
      "bright"
    ],
    "overlay_text_hint": "ไปเที่ยวต้องแต่งลุคนี้",
    "overlay_instruction": "ข้อความสั้นหนึ่งบรรทัดต่อหนึ่งภาพ",
    "hashtag_seed": [
      "#ป้ายยา",
      "#ชุดเที่ยว",
      "#ลุคสนามบิน"
    ],
    "scene_rule": "核心场景固定机场出发值机大厅；卧室行李箱仅作备选",
    "bgm_note": "operator feedback 2026-08-31: prefer strong-beat tracks; cut on beat"
  },
  "default_storyboard": {
    "topic_template": "ลุคสนามบิน: {product} ใส่เที่ยวสบายๆ แต่ชิค",
    "slots": [
      {
        "slot_index": 1,
        "slot_role": "hero",
        "purpose": "值机岛前完整 Look + 出发钩子",
        "duration_ms": 2000,
        "motion": "slow_push",
        "transition_out": "cut"
      },
      {
        "slot_index": 2,
        "slot_role": "full_look",
        "purpose": "玻璃幕墙前全身 Look 与上下身比例",
        "duration_ms": 2000,
        "motion": "light_pan",
        "transition_out": "cut"
      },
      {
        "slot_index": 3,
        "slot_role": "lifestyle",
        "purpose": "推行李箱走向登机口的自然状态",
        "duration_ms": 2000,
        "motion": "static_hold",
        "transition_out": "cut"
      },
      {
        "slot_index": 4,
        "slot_role": "detail",
        "purpose": "外套立领、门襟与绗缝细节",
        "duration_ms": 2000,
        "motion": "detail_zoom",
        "transition_out": "cut"
      },
      {
        "slot_index": 5,
        "slot_role": "second_angle",
        "purpose": "登机口回眸第二机位收尾",
        "duration_ms": 2000,
        "motion": "light_pan",
        "transition_out": "cut"
      }
    ]

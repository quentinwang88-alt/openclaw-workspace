      {"slot_index": 3, "slot_role": "lifestyle", "purpose": "办公桌前/喝咖啡办公状态", "duration_ms": 2500, "motion": "static_hold", "transition_out": "short_dissolve"},
      {"slot_index": 4, "slot_role": "detail", "purpose": "面料垂感与剪裁细节", "duration_ms": 2200, "motion": "detail_zoom", "transition_out": "short_dissolve"},

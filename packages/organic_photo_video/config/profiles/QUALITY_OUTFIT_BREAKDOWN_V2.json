{
  "schema_version": "opv-quality-profile-v1",
  "quality_profile_id": "QUALITY_OUTFIT_BREAKDOWN_V2",
  "profile_key": "QUALITY_OUTFIT_BREAKDOWN_V2",
  "profile_version": 1,
  "dimensions": {
    "anchor_naturalness": {

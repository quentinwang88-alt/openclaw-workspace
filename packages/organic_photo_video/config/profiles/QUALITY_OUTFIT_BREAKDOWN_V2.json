      "checks": ["essential_labels_readable", "no_platform_ui", "no_fake_commerce_data", "no_accidental_content_occlusion"],
      "fail_action": "recompose_board"
    },
    "narrative_quality": {
      "scope": ["group"], "min_score": 75, "hard_gate": false,
      "checks": ["p1_explains_outfit", "order_logical"],
      "fail_action": "consider_story_order_refinement"
    },
    "creator_naturalness": {
      "scope": ["single", "group", "render"], "min_score": 78, "hard_gate": false,
      "applies_to": {"exclude_slot_roles": ["detail"]},
      "checks": ["natural_skin_texture", "coherent_face_body_detail", "natural_creator_feel"],
      "fail_action": "consider_more_natural_presentation"
    },
    "shot_role_fidelity": {
      "scope": ["anchor", "single", "group", "render"], "min_score": 80, "hard_gate": true,
      "checks": ["matches_current_shot_role", "no_obvious_extra_or_missing_visible_limbs", "planned_crops_are_not_missing_limbs"],
      "fail_action": "regenerate_offending_slot"

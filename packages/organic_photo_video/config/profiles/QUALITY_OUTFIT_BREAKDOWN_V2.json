      "checks": ["natural_body_proportion", "coherent_face_and_body_detail"],
      "fail_action": "consider_more_natural_anchor"
    },
    "anchor_composition": {
      "scope": ["anchor"], "min_score": 78, "hard_gate": true,
      "applies_to": {"slot_roles": ["full_look"]},
      "checks": ["full_body_visible", "scene_matches_plan", "usable_for_person_extraction"],
      "fail_action": "regenerate_anchor_candidate"
    },
    "product_fidelity": {
      "scope": ["anchor", "single", "group", "render"], "min_score": 80, "hard_gate": true,
      "checks": ["visible_target_product_matches_reference", "no_invented_product_structure"],
      "fail_action": "regenerate_offending_slot"
    },
    "outfit_quality": {
      "scope": ["anchor", "single", "group"], "min_score": 78, "hard_gate": false,
      "applies_to": {"exclude_slot_roles": ["detail"]},
      "checks": ["visible_outfit_coherence", "product_is_visual_center"],
      "fail_action": "consider_outfit_refinement"
    },
    "persona_consistency": {
      "scope": ["anchor", "single", "group", "render"], "min_score": 80, "hard_gate": true,
      "applies_to": {"exclude_slot_roles": ["detail"]},
      "checks": ["visible_identity_matches_persona", "p1_person_matches_anchor", "no_obvious_identity_drift"],
      "fail_action": "regenerate_offending_slot"
    },
    "board_integrity": {
      "scope": ["single", "group"], "min_score": 80, "hard_gate": true,

    "render_framing": {
      "scope": ["render"], "min_score": 80, "hard_gate": true,
      "checks": ["text_readable", "no_new_crop_of_shoes_or_garment", "p1_first", "frozen_group_consistency"],
      "fail_action": "rerender"
    },
    "group_quality": {
      "scope": ["group"], "min_score": 75, "hard_gate": false,
      "checks": ["visual_style_coherent", "story_order_logical"],
      "fail_action": "consider_group_refinement"
    }
